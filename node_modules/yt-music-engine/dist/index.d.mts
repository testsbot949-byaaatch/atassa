// Clean title string by removing common noise
function cleanString(str) {
  if (!str) return '';
  return str
    .toLowerCase()
    .replace(/\(.*?\)/g, '')
    .replace(/\[.*?\]/g, '')
    .replace(/official|music|video|audio|lyric|lyrics|full|song|hd|4k|1080p/gi, '')
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

// Extract core song name
function extractCoreSongName(title) {
  let songName = cleanString(title);
  if (title.includes(' - ')) {
    const parts = title.split(' - ');
    const cleanParts = parts.map(p => cleanString(p));
    const shortestPart = cleanParts
      .filter(p => p.length > 2 && p.length < 30)
      .sort((a, b) => a.length - b.length)[0];
    if (shortestPart) return shortestPart;
  }
  return songName.split(' ').slice(0, 4).join(' ');
}

// Extract main artist name from title or channel
function extractArtist(title, channelName) {
  if (title && title.includes(' - ')) {
    const parts = title.split(' - ');
    const artistCandidate = cleanString(parts[0]);
    if (artistCandidate.length > 2 && artistCandidate.length < 30) {
      return artistCandidate;
    }
  }
  if (channelName) {
    return cleanString(channelName)
      .replace(/vevo$/i, '')
      .replace(/official$/i, '')
      .replace(/topic$/i, '')
      .trim();
  }
  return '';
}

// Filter out bad variations (slowed, reverb, lofi, remix, covers)
function isBadVariation(baseTitle, candTitle) {
  const badKeywords = [
    "lofi", "lo-fi", "8bit", "8-bit", "reverb", "slowed", "nightcore", "daycore", 
    "remix", "mashup", "live", "cover", "sped up", "acoustic", "instrumental", 
    "karaoke", "bassboost", "hardstyle", "vaporwave"
  ];
  
  const baseLower = (baseTitle || '').toLowerCase();
  const candLower = (candTitle || '').toLowerCase();

  for (const word of badKeywords) {
    if (candLower.includes(word) && !baseLower.includes(word)) {
      return true;
    }
  }
  return false;
}

// Semantic duplicate check
function isSemanticDuplicate(candidateTitle, existingTitles = []) {
  const candCore = extractCoreSongName(candidateTitle);
  for (const existing of existingTitles) {
    const existCore = extractCoreSongName(existing);
    if (candCore === existCore) return true;
    if (candCore.length > 3 && existCore.length > 3) {
      if (candCore.includes(existCore) || existCore.includes(candCore)) return true;
    }
    const words1 = candCore.split(' ').filter(w => w.length > 2);
    const words2 = existCore.split(' ').filter(w => w.length > 2);
    if (words1.length > 0 && words2.length > 0) {
      const matchCount = words1.filter(w => words2.includes(w)).length;
      if (matchCount >= Math.min(words1.length, words2.length)) return true;
    }
  }
  return false;
}

// Fetch helper via Piped API / Invidious API / YouTube Scraper with multiple fallbacks
async function fetchYouTubeSearch(query) {
  const ENDPOINTS = [
    `https://pipedapi.kavin.rocks/search?q=${encodeURIComponent(query)}`,
    `https://api.piped.private.coffee/search?q=${encodeURIComponent(query)}`,
    `https://invidious.projectsegfault.com/api/v1/search?q=${encodeURIComponent(query)}&type=video`,
    `https://inv.tux.pizza/api/v1/search?q=${encodeURIComponent(query)}&type=video`,
    `https://yewtu.be/api/v1/search?q=${encodeURIComponent(query)}&type=video`
  ];

  for (const endpoint of ENDPOINTS) {
    try {
      const res = await fetch(endpoint, { signal: AbortSignal.timeout(4000) });
      if (res.ok) {
        const data = await res.json();
        const items = Array.isArray(data) ? data : (data.items || []);
        if (items.length > 0) {
          return items.map(item => ({
            videoId: item.videoId || (item.url ? item.url.replace('/watch?v=', '') : ''),
            title: item.title || 'Untitled',
            author: item.author || item.uploaderName || 'Unknown',
            thumbnail: item.thumbnail || item.videoThumbnails?.[0]?.url || `https://img.youtube.com/vi/${item.videoId}/hqdefault.jpg`,
            duration: item.duration || item.lengthSeconds || 0
          })).filter(i => i.videoId);
        }
      }
    } catch (err) {}
  }

  // Direct YouTube HTML Scraper fallback
  try {
    const searchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(query)}`;
    const response = await fetch(searchUrl, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
        'Accept-Language': 'en-US,en;q=0.9',
      },
      signal: AbortSignal.timeout(6000)
    });

    if (response.ok) {
      const html = await response.text();
      const match = html.match(/var ytInitialData = ({.+?});/);
      if (match) {
        const data = JSON.parse(match[1]);
        const contents = data?.contents?.twoColumnSearchResultsRenderer?.primaryContents?.sectionListRenderer?.contents?.[0]?.itemSectionRenderer?.contents || [];
        
        const results = [];
        for (const item of contents) {
          const v = item.videoRenderer;
          if (!v || !v.videoId) continue;
          results.push({
            videoId: v.videoId,
            title: v.title?.runs?.[0]?.text || 'Untitled',
            author: v.ownerText?.runs?.[0]?.text || 'Unknown',
            thumbnail: `https://img.youtube.com/vi/${v.videoId}/mqdefault.jpg`,
            duration: (v.lengthText?.simpleText || '0:00').split(':').reduce((acc, time) => (60 * acc) + +time, 0)
          });
        }
        return results;
      }
    }
  } catch (err) {}

  return [];
}

// 1. Ultra Fast & Reliable Search YouTube
async function searchYouTube(query, options = {}) {
  if (!query) throw new Error('Missing search query');
  const limit = Math.min(Math.max(parseInt(options.limit) || 10, 1), 25);
  
  // Smart query optimization for official HQ tracks
  const isHQQuery = query.toLowerCase().includes('official') || query.toLowerCase().includes('audio') || query.toLowerCase().includes('topic');
  const searchQuery = isHQQuery ? query : `${query} official audio`;

  const items = await fetchYouTubeSearch(searchQuery);

  return items.slice(0, limit).map(item => {
    const videoId = item.url ? item.url.replace('/watch?v=', '') : item.videoId;
    return {
      videoId,
      title: item.title || 'Untitled',
      channelName: item.uploaderName || item.author || 'Unknown',
      thumbnail: item.thumbnail || `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`,
      duration: String(item.duration || 0),
      youtubeUrl: `https://www.youtube.com/watch?v=${videoId}`,
      audioUrl: `https://pipedapi.kavin.rocks/streams/${videoId}` // Direct stream endpoint
    };
  });
}

// 2. Extract Stream & Details from URL or videoId
async function getStreamUrls(videoId) {
  if (!videoId) throw new Error('Missing videoId');
  const cleanId = videoId.replace('https://www.youtube.com/watch?v=', '').replace('https://youtu.be/', '');

  // 1. Try Invidious / Piped audio stream instances
  const INSTANCES = [
    `https://inv.tux.pizza/api/v1/videos/${cleanId}`,
    `https://invidious.projectsegfault.com/api/v1/videos/${cleanId}`,
    `https://yewtu.be/api/v1/videos/${cleanId}`,
    `https://pipedapi.kavin.rocks/streams/${cleanId}`
  ];

  for (const endpoint of INSTANCES) {
    try {
      const res = await fetch(endpoint, {
        headers: { 'User-Agent': 'Mozilla/5.0' },
        signal: AbortSignal.timeout(5000)
      });
      if (res.ok) {
        const data = await res.json();
        const audioStreams = data.adaptiveFormats ? data.adaptiveFormats.filter(f => f.type && f.type.includes('audio')) : (data.audioStreams || []);
        audioStreams.sort((a, b) => (parseInt(b.bitrate) || 0) - (parseInt(a.bitrate) || 0));

        if (audioStreams.length > 0 && audioStreams[0].url) {
          return {
            videoId: cleanId,
            title: data.title || 'YouTube Track',
            thumbnail: data.videoThumbnails?.[0]?.url || `https://img.youtube.com/vi/${cleanId}/hqdefault.jpg`,
            audioUrl: audioStreams[0].url,
            videoUrl: data.formatStreams?.[0]?.url || '',
            duration: data.lengthSeconds || 0,
            artist: data.author || 'YouTube'
          };
        }
      }
    } catch (err) {}
  }

  // 2. Fallback stream
  return {
    videoId: cleanId,
    title: 'YouTube Track',
    thumbnail: `https://img.youtube.com/vi/${cleanId}/hqdefault.jpg`,
    audioUrl: `https://pipedapi.kavin.rocks/streams/${cleanId}`,
    videoUrl: `https://www.youtube.com/watch?v=${cleanId}`,
    duration: 0,
    artist: 'YouTube'
  };
}

// 3. Harmonix Smart Autoplay & Recommendations Engine
async function getAutoplay(baseTrack, options = {}) {
  if (!baseTrack) throw new Error('Missing baseTrack parameter');
  
  const videoId = baseTrack.videoId || baseTrack.identifier || '';
  const title = baseTrack.title || baseTrack.info?.title || '';
  const author = baseTrack.author || baseTrack.channelName || baseTrack.info?.author || '';
  const existingTitles = options.existingTitles || [];

  const coreSong = extractCoreSongName(title);
  const artist = extractArtist(title, author);

  const allExcludes = [title, ...existingTitles].filter(Boolean);

  // Multi-Strategy Search
  const queries = [];
  if (artist) {
    queries.push(`${artist} top tracks`);
    queries.push(`${artist} songs`);
  }
  if (coreSong && coreSong.length > 2) {
    queries.push(`${coreSong} similar songs`);
  }
  queries.push('trending music 2024');

  const recommendations = [];

  for (const q of queries) {
    if (recommendations.length >= (options.limit || 10)) break;
    
    const items = await fetchYouTubeSearch(q);

    for (const item of items) {
      const itemTitle = item.title || '';
      const itemVideoId = item.url ? item.url.replace('/watch?v=', '') : item.videoId;

      if (itemVideoId === videoId) continue;
      if (isBadVariation(title, itemTitle)) continue;
      if (isSemanticDuplicate(itemTitle, allExcludes)) continue;

      recommendations.push({
        videoId: itemVideoId,
        title: itemTitle,
        channelName: item.uploaderName || 'Unknown',
        thumbnail: item.thumbnail || `https://img.youtube.com/vi/${itemVideoId}/hqdefault.jpg`,
        duration: String(item.duration || 0),
        youtubeUrl: `https://www.youtube.com/watch?v=${itemVideoId}`
      });

      allExcludes.push(itemTitle);
      if (recommendations.length >= (options.limit || 10)) break;
    }
  }

  return recommendations;
}

var index = {
  searchYouTube,
  getStreamUrls,
  getAutoplay
};

export { index as default, getAutoplay, getStreamUrls, searchYouTube };
