{
  "name": "yt-music-engine",
  "version": "1.2.0",
  "description": "Extract direct audio and video streams from YouTube search queries or URLs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --dts --clean"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "youtube",
    "stream",
    "extractor",
    "audio",
    "video",
    "download",
    "play",
    "youtube-audio",
    "youtube-video"
  ],
  "author": "iy3k",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagexdd/yt-music-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Sagexdd/yt-music-engine/issues"
  },
  "homepage": "https://github.com/Sagexdd/yt-music-engine#readme",
  "dependencies": {
    "youtube-dl-exec": "^3.1.9",
    "youtubei.js": "^17.2.0"
  }
}
